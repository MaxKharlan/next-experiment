data: {"kind": "hypotheses", "catalog_version": "answer-cut-v1", "hypotheses": [{"id": "h1", "fault_class": "pad_eos_masking", "location": "training code where labels are masked: if eos_as_pad=True then EOS token id is treated as pad and masked with -100", "prior": 0.4, "rationale": "The observation notes that true EOS targets are masked along with padding when eos_as_pad is enabled, which would remove supervision for the stop token and degrade exact label quality.", "sources": []}, {"id": "h2", "fault_class": "grad_accum_normalization", "location": "gradient accumulation loop where loss is averaged per micro-batch before backward pass", "prior": 0.2, "rationale": "Averaging the loss per micro-batch can effectively reduce the gradient scale, mimicking a lower learning rate and potentially causing slow convergence or underfitting.", "sources": []}, {"id": "h3", "fault_class": "lora_rank_too_small", "location": "LoRA configuration: lora_r=16 for Qwen3-0.6B", "prior": 0.15, "rationale": "For a 0.6B parameter model, a rank of 16 may be insufficient to capture the needed adaptation, leading to stalled quality despite sufficient training steps.", "sources": []}, {"id": "h4", "fault_class": "too_many_epochs", "location": "hyperparameter n_epochs=3", "prior": 0.1, "rationale": "With a small dataset and gradient accumulation, three epochs could cause overfitting to the training set, raising validation loss after its minimum and hurting generalization.", "sources": []}], "probs": {"h1": 0.4, "h2": 0.2, "h3": 0.15, "h4": 0.1, "unlisted": 0.15}}

