# Token Factory
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEMOTRON_NANO_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
NEMOTRON_SUPER_MODEL=nvidia/nemotron-3-super-120b-a12b
NEMOTRON_ULTRA_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b

# Hugging Face (tokenizers, datasets, Llama license)
HF_TOKEN=

# Local storage and database
STORAGE_BACKEND=local
ARTIFACTS_DIR=./artifacts
DATABASE_URL=sqlite:///./artifacts/next_experiment.db

# Optional
TAVILY_API_KEY=

# Agent limits (starting values)
DEFAULT_BUDGET_USD=5
APPROVAL_THRESHOLD_USD=1
PUBLIC_DEMO=false

# Silence the "PyTorch was not found" warning from transformers
TRANSFORMERS_VERBOSITY=error